<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.pansen.wgd.session-agent</string>

    <!-- `launchd agent run` is long-lived: it reconciles this user's
         Automatic connections on start, then blocks on SIGTERM and
         disconnects them again before exiting. launchd sends SIGTERM to
         Aqua-session agents at logout, so this covers logout. It does NOT
         cover fast user switching (switching sessions does not terminate the
         other session's agents), so a tunnel can still be live in a
         switched-away session today. -->
    <key>ProgramArguments</key>
    <array>
        <string>@WGD_BIN@</string>
        <string>launchd</string>
        <string>agent</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true />
    <key>KeepAlive</key>
    <true />

    <!-- No `ExitTimeOut`: launchd's 5s default is the whole budget for the
         logout teardown, and a teardown that needs longer counts as broken.
         The daemon finishes a disconnect it has already received even if
         launchd kills this agent; only requests not yet sent are lost. At
         shutdown launchd removes the daemon at the same moment, so the agent
         cannot reach it anyway; see issues/shutdown-teardown.md. -->

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>   <!-- only in a real GUI login session -->

    <key>StandardOutPath</key>
    <string>@WGD_HOME@/Library/Logs/wgd-session-agent.out.log</string>
    <key>StandardErrorPath</key>
    <string>@WGD_HOME@/Library/Logs/wgd-session-agent.err.log</string>
</dict>
</plist>
