<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.pansen.wgd.privileged</string>

    <key>ProgramArguments</key>
    <array>
        <string>@WGD_BIN@</string>
        <string>--debug</string>
        <string>privileged</string>
        <string>--serve</string>
        <string>--authorized-group</string>
        <string>wgd</string>
        <string>--autostarted</string>
        <string>--idle-timeout-ms</string>
        <string>60000</string>
    </array>

    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockPathName</key>
            <string>/Library/Application Support/wgd/run/ctl.sock</string>
            <!-- @SOCK_PATH_GROUP@ replaced at install time with SockPathGroup = integer GID of the wgd group; e.g. GID 20 becomes: <key>SockPathGroup</key> <integer>20</integer> -->
            <!-- 0660 octal = 432 decimal; plist <integer> is base-10 -->
            <key>SockPathMode</key>
            <integer>432</integer>
        </dict>
    </dict>

    <!-- Finding 3 — Executable substitution through PATH: privileged commands
         must never search user-writable Homebrew directories. Subprocesses append
         /usr/local/bin at runtime only after checking ownership and permissions. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>WGD_LOG_COLOR</key>
        <string>always</string>
    </dict>

    <!-- On-demand: launchd spawns on first connect, daemon exits on idle, launchd re-spawns. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- DNS crash recovery: while a tunnel that promotes DNS is up (or a
         restore is pending) the daemon creates this sentinel, and launchd keeps
         the daemon running, including at boot, until it removes it again. See
         issues/dns-crash-recovery.md. -->
    <key>KeepAlive</key>
    <dict>
        <key>PathState</key>
        <dict>
            <key>/Library/Application Support/wgd/dns-custody/watch</key>
            <true/>
        </dict>
    </dict>

    <!-- No `ExitTimeOut`: launchd's default is 5s (`launchctl print` shows
         `exit timeout = 5`), and the daemon installs no SIGTERM handler, so it
         exits at once anyway. A future SIGTERM teardown has to fit into
         these 5s too; see issues/shutdown-teardown.md, item 3. -->

    <key>StandardOutPath</key>
    <string>/var/log/wgd/privileged.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/wgd/privileged.err.log</string>
</dict>
</plist>
